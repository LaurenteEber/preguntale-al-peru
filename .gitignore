# Biblioteca: en git solo metadatos (capturas/*/datapackage.json, verificaciones.jsonl, manifiestos, pruebas).
# Los crudos, los Parquet y los derivados se reconstruyen con `pap construir` y `pap calcular`.
biblioteca/cruda/almacen/
biblioteca/cruda/bandeja/
biblioteca/cruda/cache/
biblioteca/cruda/*.xlsx
biblioteca/cruda/indice.duckdb*
biblioteca/**/*.parquet
biblioteca/**/historial/
biblioteca/**/.preparacion_*/
biblioteca/_respaldo*/

# Intermedio del catálogo (lo regenera catalogo/scripts/run.py)
catalogo/scripts/catalogo_fuentes_v2.json

# Para apagar conf de MCP que se usa solo en cloud
.claude/settings.local.json

# M0-00: copias del cubo para la regresión (solo se registra su huella)
backlog/**/evidencia/*.parquet
